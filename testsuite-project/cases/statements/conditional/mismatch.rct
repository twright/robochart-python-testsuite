// Statement case: conditional/mismatch
// Faulty translation swaps branch bodies.
package statement_conditional_mismatch
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output
  robotic platform rp0 {
    event output : Obs
  }
  controller ctrl0 {
    event output : Obs
    stm stm0 {
      var x : int = -1
      var y : int = 0
      event output : Obs
      initial i0
      state s0 {}
      transition t0 {
        from i0
        to s0
        action if x > 0 then y = 1 else y = 2 end; output ! Obs(| x = x, y = y |)
      }
    }
    connection stm0 on output to ctrl0 on output
  }
}
record Obs { x: int y: int }
