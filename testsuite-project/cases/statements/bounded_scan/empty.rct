// Statement case: bounded_scan/empty
// A zero-step scan leaves the index, total, and input sequence unchanged.
// Fixed iteration fixture: {"index":"i","count":0}
// Finite CSP fixture domains:
// {
//   "values": {
//     "Seq(int)": [
//       [
//         2
//       ]
//     ]
//   }
// }
package statement_bounded_scan_empty
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output
  robotic platform rp0 {
    event output : Obs
  }
  controller ctrl0 {
    event output : Obs
    stm stm0 {
      var i : int = 4
      const ranges : Seq(int) = <2>
      var total : int = 5
      event output : Obs
      initial i0
      state s0 {}
      transition t0 {
        from i0
        to s0
        action output ! Obs(| i = i, total = total, ranges = ranges |)
      }
    }
    connection stm0 on output to ctrl0 on output
  }
}
record Obs { i: int total: int ranges: Seq(int) }
