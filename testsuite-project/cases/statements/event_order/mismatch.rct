// Statement case: event_order/mismatch
// Deliberately reverse the signal and typed SpinCommand; the expected trace is command then signal.
// Finite CSP fixture domains:
// {
//   "values": {
//     "SpinCommand": [
//       {
//         "angleVelocity": 2,
//         "duration": 1
//       }
//     ]
//   }
// }
package statement_event_order_mismatch
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output
  connection ctrl0 on accepted to rp0 on accepted
  connection ctrl0 on command to rp0 on command
  robotic platform rp0 {
    event output : Obs
    event accepted
    event command : SpinCommand
  }
  controller ctrl0 {
    event output : Obs
    event accepted
    event command : SpinCommand
    stm stm0 {
      var cmd : SpinCommand = SpinCommand(| angleVelocity = 2, duration = 1 |)
      event output : Obs
      event accepted
      event command : SpinCommand
      initial i0
      state s0 {}
      transition t0 {
        from i0
        to s0
        action accepted; command ! cmd; output ! Obs(| cmd = cmd |)
      }
    }
    connection stm0 on output to ctrl0 on output
    connection stm0 on accepted to ctrl0 on accepted
    connection stm0 on command to ctrl0 on command
  }
}
record Obs { cmd: SpinCommand }
datatype SpinCommand { angleVelocity : int duration : int }
