// Statement case: conditional_threshold/below
// Nested conditional at the threshold boundary (below); integer values.
package statement_conditional_threshold_below
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output
  robotic platform rp0 {
    event output : Obs
  }
  controller ctrl0 {
    event output : Obs
    stm stm0 {
      var verdict : int = 0
      var x : int = 1
      event output : Obs
      initial i0
      state s0 {}
      transition t0 {
        from i0
        to s0
        action if x < 2 then verdict = 1 else if x == 2 then verdict = 2 else verdict = 3 end end; output ! Obs(| x = x, verdict = verdict |)
      }
    }
    connection stm0 on output to ctrl0 on output
  }
}
record Obs { x: int verdict: int }
