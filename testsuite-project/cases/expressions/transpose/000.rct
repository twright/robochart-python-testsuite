package expression_transpose_000
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output ( _async )
  robotic platform rp0 {
    event output : matrix(int,2,2)
  }
  controller ctrl0 {
    event output : matrix(int,2,2)
    stm stm0 {
      // context rule: matrix_output_type
      event output : matrix(int,2,2)
      initial i0
      final f0
      transition t0 {
        from i0
        to f0
        action output ! (transpose(matrix))
      }
    }
    connection stm0 on output to ctrl0 on output
  }
}
