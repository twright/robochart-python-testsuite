package expression_comprehension_True_True_bounded_002
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output ( _async )
  robotic platform rp0 {
    event output : Set(int)
  }
  controller ctrl0 {
    event output : Set(int)
    stm stm0 {
      // context rule: quantifier_binders
      var x : int
      // context rule: inferred_inputs
      const domain : Set(int) = { 0 }
      // context rule: inferred_output_type
      event output : Set(int)
      initial i0
      final f0
      transition t0 {
        from i0
        to f0
        action output ! ({x: int | x in domain /\ (x > 0) @ x + 1})
      }
    }
    connection stm0 on output to ctrl0 on output
  }
}
