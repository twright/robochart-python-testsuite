package expression_multiple_variables_002
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output ( _async )
  robotic platform rp0 {
    event output : boolean
  }
  controller ctrl0 {
    event output : boolean
    stm stm0 {
      // context rule: quantifier_binders
      var x : int
      var y : int
      // context rule: inferred_output_type
      event output : boolean
      initial i0
      final f0
      transition t0 {
        from i0
        to f0
        action output ! (forall x: int, y: int @ x == y)
      }
    }
    connection stm0 on output to ctrl0 on output
  }
}
