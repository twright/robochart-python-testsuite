package expression_vector_000
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output ( _async )
  robotic platform rp0 {
    event output : vector(int,2)
  }
  controller ctrl0 {
    event output : vector(int,2)
    stm stm0 {
      // context rule: vector_output_type
      event output : vector(int,2)
      initial i0
      final f0
      transition t0 {
        from i0
        to f0
        action output ! ([|1, 2|])
      }
    }
    connection stm0 on output to ctrl0 on output
  }
}
