package expression_conditional_001
import sequence_toolkit::*
module mod0 {
  connection ctrl0 on output to rp0 on output ( _async )
  robotic platform rp0 {
    event output : int
  }
  controller ctrl0 {
    event output : int
    stm stm0 {
      // context rule: inferred_inputs
      const a : boolean = false
      const b : boolean = true
      // context rule: inferred_output_type
      event output : int
      initial i0
      final f0
      transition t0 {
        from i0
        to f0
        action output ! (if a then 1 else 2 end)
      }
    }
    connection stm0 on output to ctrl0 on output
  }
}
